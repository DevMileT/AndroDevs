<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de copia de seguridad y transferencia (Android 12 o superior).
    La ubicación de las victorias se guarda solo en el dispositivo,
    así que la base de datos se excluye de la copia en la nube y de la
    transferencia directa entre móviles.
    Los archivos -journal, -wal y -shm son auxiliares de SQLite y pueden no existir.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="lucky_sevens.db" />
        <exclude domain="database" path="lucky_sevens.db-journal" />
        <exclude domain="database" path="lucky_sevens.db-wal" />
        <exclude domain="database" path="lucky_sevens.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="lucky_sevens.db" />
        <exclude domain="database" path="lucky_sevens.db-journal" />
        <exclude domain="database" path="lucky_sevens.db-wal" />
        <exclude domain="database" path="lucky_sevens.db-shm" />
    </device-transfer>
</data-extraction-rules>